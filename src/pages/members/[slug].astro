---
import { type CollectionEntry } from 'astro:content';
// Components
import App from '@layouts/App.astro';
import MemberHero from '@components/members/MemberHero.astro';
import SquadCompact from '@components/members/SquadCompact.astro';
import DomesticLeagueTable from '@components/members/DomesticLeagueTable.astro';
import MemberClubs from '@components/members/MemberClubs.astro';
import ScoreDetails from '@components/members/ScoreDetails.astro';
import TournamentParticipationTable from '@components/members/TournamentParticipationTable.astro';
import TeamLastMatches from '@components/members/TeamLastMatches.astro';
import TeamHeadToHead from '@components/members/TeamHeadToHead.astro';
import MatchCard from '@components/matches/MatchCard.astro'; //Match card with stadium
import ScorersTable from '@components/tournaments/ScorersTable.astro'; //This one shows both scorers and assists
import RecordsAndStats from '@components/members/RecordsAndStats.astro';
import RelatedNews from '@components/articles/RelatedNews.astro';
// Collections ASYNC, NEED AWAIT
import { getTournaments, getMatches, getMembers, getArticles } from '@lib/collections';

// Utils
import { CURRENT_SEASON } from '@config/season';
import { getMemberTotalScore, getMemberScoreDetails } from '@lib/rankingUtils';
import { getMemberRank } from 'src/utils/memberUtils';
import { getArticlesByTags } from 'src/utils/articleUtils';
import { getAchievementsForMember } from '@lib/achievements/dynamics/index';
import { FEATURES } from '@config/features';
import { ROUTES } from '@config/routes';
import { getFirstDivision } from '@data/leagues';
import { loadClubsByFederation } from '@data/clubs';


type MemberType = CollectionEntry<'members'>; // Should use @types/collections.d.ts

interface Props {
  member: MemberType;
}
// Static Paths (URLs: members/[slug])
export const prerender = true; 
export async function getStaticPaths() {
  const members = await getMembers();
  return members.map((member: MemberType) => ({
    params: { slug: member.id },
    props: { member },
  }));
}

// --- Member that will be rendered as specified in the URL ---
const { member } = Astro.props;
// If the inserted path doesn't exist, redirect to 404 (member/asdfasdf)
if (!member) {
  return Astro.redirect('/404');
}

const memberData = member.data; // Member data
// Collections
const matches = await getMatches();
const tournaments = await getTournaments();
const members = await getMembers();

// Liga doméstica / clubes de la federación del miembro (infra B2)
const firstDivision = getFirstDivision(memberData.id);
const memberClubs = loadClubsByFederation(memberData.code);
const memberHasClubs = memberClubs.length > 0;

// Partidos jugados del miembro, por id global (fuente de verdad Fase D)
const playedMatches = matches
  .filter(match => match.data.status === 'played' && (match.data.team1Id === memberData.id || match.data.team2Id === memberData.id));
// Sort played matches by date
playedMatches.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// this is for the member hero
const memberRank = await getMemberRank(member, CURRENT_SEASON);
const memberTotalScoreResult = await getMemberTotalScore(member, CURRENT_SEASON);
const memberScoreDetails = await getMemberScoreDetails(member, CURRENT_SEASON);
const memberTotalScore = memberTotalScoreResult.totalScore;
const titles = tournaments
  .filter(t => t.data.champion === memberData.name)
  .map(t => ({ year: t.data.edition }));

const achievements = FEATURES.achievements ? await getAchievementsForMember(memberData.name) : [];

// Articles
const articles = await getArticles();
const filterTags = [member.id]; // the articles should have the nation slug as tag to be shown
const filteredArticles = getArticlesByTags(articles, filterTags);
---

<App title={`FFC - ${memberData.name}`}>
  <div class="md:container m-auto p-4 py-8">
    <MemberHero memberData={memberData} ranking={memberRank} points={memberTotalScore} titles={titles} achievements={achievements} scoreBreakdown={memberScoreDetails} />
    <div class="flex justify-center mt-3">
      <a
        href={ROUTES.members.achievements(member.id)}
        class="px-4 py-2 rounded-lg bg-surface border border-primary text-primary-soft text-sm font-semibold hover:bg-primary/20 hover:text-white transition-colors"
      >
        View all achievements →
      </a>
    </div>
    <!-- <ScoreDetails scoreData={memberScoreDetails} /> -->

    <SquadCompact teamId={memberData.id} teamCode={memberData.code} teamName={memberData.name} teamType="national" />

    {firstDivision ? (
      <DomesticLeagueTable league={firstDivision} />
    ) : memberHasClubs ? (
      <MemberClubs member={member} />
    ) : null}

    <TournamentParticipationTable
      teamId={memberData.id}
      teamName={memberData.name}
      matches={matches}
      type="forest-cup"
    />
    <!-- Middle Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
      <TeamLastMatches teamId={memberData.id} matches={matches} />
      <div class="bg-surface/80 shadow-lg rounded-lg p-6">
        <TeamHeadToHead teamId={memberData.id} matches={matches} />
        <ScorersTable teamId={memberData.id} teamName={memberData.name} matches={playedMatches} />
      </div>
    </div>
    <!-- Bottom: Records and Stats -->
    <RecordsAndStats teamId={memberData.id} teamName={memberData.name} matches={playedMatches} />
    <!-- Related News only if there exists -->
    {filteredArticles.length > 0 && (
      <RelatedNews articles={filteredArticles} max={4} />
    )}
  </div>
</App>