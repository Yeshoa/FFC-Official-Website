---
// Ranking FCL: ranking propio de la Champions League, separado e independiente
// del ranking de selecciones (NO suma al ranking general). Métrica: rating del
// club (agregación del plantel, 0-100 → estrellas). Cuando existan partidos de
// CL, se podrá sumar rendimiento FCL (ver [[03-ranking]] §5 y [[09-dudas]] §6).
import FCLayout from '@layouts/FCL.astro';
import Title from '@components/Title.astro';
import { getAllClubs } from '@data/clubs';
import { getMemberById } from 'src/utils/memberUtils';
import { loadCurrentSquadByTeamId } from '@data/players';
import { computeTeamRating, teamRatingToStars } from '@config/rating';
import { getRankClass } from '@lib/rankingUtils';
import StarsDisplay from '@components/ui/StarsDisplay.astro';
import { ROUTES } from '@config/routes';

const clubs = getAllClubs()
  .map((club) => {
    const squad = loadCurrentSquadByTeamId(club.id);
    const rating = computeTeamRating(squad);
    return {
      club,
      federation: getMemberById(club.federationId),
      rating,
      stars: teamRatingToStars(rating),
    };
  })
  .sort((a, b) => b.rating - a.rating || a.club.name.localeCompare(b.club.name));
---

<FCLayout title="FFC - Champions League Ranking">
  <main class="flex flex-col items-center pt-5">
    <div class="flex flex-col items-center w-full max-w-5xl justify-center p-6">
      <Title slideIn={true} color="text-cl-lime">
        Champions League Ranking
        <span slot="subtitle">Club ranking · does not affect the general ranking</span>
      </Title>

      {clubs.length > 0 ? (
        <div class="w-full overflow-x-auto rounded-lg">
          <table class="w-full border-collapse text-sm">
            <thead class="bg-primary-deep uppercase">
              <tr>
                <th class="w-8 px-2 py-3 text-center border-b border-primary rounded-tl-xl" title="Position">°</th>
                <th class="py-3 text-left border-b border-primary min-w-[120px]">Club</th>
                <th class="py-3 text-left border-b border-primary hidden sm:table-cell">Federation</th>
                <th class="w-16 px-2 py-3 text-center border-b border-primary" title="Rating">OVR</th>
                <th class="w-28 px-2 py-3 text-center border-b border-primary rounded-tr-xl" title="Stars">Rating</th>
              </tr>
            </thead>
            <tbody class="text-center text-primary-light">
              {clubs.map(({ club, federation, rating, stars }, index) => {
                const primary = club.colors?.primary ?? '#95ff00';
                return (
                  <tr class="border-b border-primary-dark hover:bg-primary-deep/30 transition duration-150 odd:bg-surface-raised/30">
                    <td class={`py-2 font-semibold border-r border-primary-dark ${getRankClass(index + 1)}`}>{index + 1}</td>
                    <td class="ps-2 py-2 text-left">
                      <a
                        href={ROUTES.clubs.detail(club.slug)}
                        class="inline-flex items-center gap-3 font-semibold hover:underline text-white"
                        title={club.name}
                      >
                        <span
                          class="inline-flex h-8 w-8 items-center justify-center rounded-lg border text-xs font-black"
                          style={{ backgroundColor: `${primary}18`, borderColor: primary, color: primary }}
                        >
                          {club.shortName?.[0] ?? club.name[0]}
                        </span>
                        <span class="truncate">{club.name}</span>
                      </a>
                    </td>
                    <td class="hidden sm:table-cell ps-2 py-2 text-left text-text-muted">
                      {federation?.data.name ?? club.federation}
                    </td>
                    <td class="px-2 py-2 font-bold" style={{ color: primary }}>{rating || '-'}</td>
                    <td class="px-2 py-2">
                      <div class="flex justify-center">
                        <StarsDisplay value={stars} size="w-3.5 h-3.5" />
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="text-text-muted italic mt-8">No clubs yet.</p>
      )}
    </div>
  </main>
</FCLayout>