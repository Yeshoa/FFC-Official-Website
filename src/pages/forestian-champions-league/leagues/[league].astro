---
// Página de una liga/división: tabla de posiciones + historial de campeones.
// Header con bandera del país, logo de la división, nombre, país, división y temporada.
import FCLayout from '@layouts/FCL.astro';
import { Image } from 'astro:assets';
import { getAllLeagues, getLeaguesByFederation, type League } from '@data/leagues';
import { getMemberById } from 'src/utils/memberUtils';
import { getClubById } from '@data/clubs';
import { resolveImage } from '@utils/imageAssets';
import DefaultLeagueLogo from '@images/leagues/default.png';
import DomesticLeagueTable from '@components/members/DomesticLeagueTable.astro';
import StarIcon from '@images/icons/star-solid.svg';
import { ROUTES } from '@config/routes';
import { LINKS } from '@config/links';
import Image from 'astro/components/Image.astro';

export async function getStaticPaths() {
  return getAllLeagues().map((league) => ({
    params: { league: league.id },
    props: { league },
  }));
}

const { league } = Astro.props as { league: League };
if (!league) return Astro.redirect('/404');

const federation = getMemberById(league.federationId);
const logo = resolveImage(league.logoPath);

// Divisiones del mismo país (para navegar entre ellas).
const divisions = getLeaguesByFederation(league.federationId);

// Historial cronológico (para contar títulos) y display nuevo → viejo.
const history = (league.history ?? []).slice().sort((a, b) => a.season - b.season);
const titleCount = new Map<number, number>();
const rows = history.map((h) => {
  const ordinal = (titleCount.get(h.championId) ?? 0) + 1;
  titleCount.set(h.championId, ordinal);
  return { ...h, ordinal };
});
rows.reverse();

const clubName = (id?: number) => (id != null ? (getClubById(id)?.name ?? `#${id}`) : '—');
---

<FCLayout title={`FFC - ${league.name}`}>
  <main class="flex flex-col items-center pt-5">
    <div class="flex flex-col items-center w-full max-w-8xl justify-center p-6">
      <nav class="w-full text-xs text-text-muted mb-4">
        <a href={ROUTES.championsLeague.leagues} class="hover:text-cl-lime underline transition-colors">Leagues</a>
        <span aria-hidden class="mx-1">›</span>
        <span>{league.name}</span>
      </nav>

      <div class="w-full rounded-2xl border border-cl-lime/20 bg-cl-black/40 p-6 md:p-10 mb-8">
        <div class="flex flex-col md:flex-row items-center gap-6 md:gap-12">
          <Image
            src={logo ?? DefaultLeagueLogo}
            alt={`${league.name} Logo`}
            width={256}
            loading="eager"
            quality={70}
            format="webp"
            class="w-40 h-40 md:w-52 md:h-52 object-contain shrink-0"
          />

          <div class="flex-1 min-w-0 flex flex-col gap-5 text-center md:text-left">
            <div class="flex flex-col sm:flex-row items-center gap-4">
              {federation?.data.flagPath && (
                <a href={ROUTES.members.detail(federation.id)} rel="noopener noreferrer" class="shrink-0">
                  <Image
                    src={federation.data.flagPath}
                    alt={federation.data.name}
                    width={160}
                    loading="eager"
                    quality={70}
                    format="webp"
                    class="w-24 h-16 md:w-28 md:h-[74px] rounded-md object-cover ring-1 ring-cl-lime/40"
                  />
                </a>
              )}
              <div class="min-w-0">
                <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white leading-tight">{league.name}</h1>
                <p class="text-base md:text-lg text-text-muted mt-2">
                  {federation?.data.name ?? `Federation #${league.federationId}`} Division {league.division}
                </p>
              </div>
            </div>

            {divisions.length > 1 && (
              <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
                <span class="text-xs uppercase tracking-wider text-text-muted">Divisions</span>
                {divisions.map((l) =>
                  l.id === league.id ? (
                    <span key={l.id} class="px-3 py-1 rounded bg-cl-lime text-black text-sm font-bold">{l.division}</span>
                  ) : (
                    <a
                      key={l.id}
                      href={ROUTES.championsLeague.league(l.id)}
                      title={l.name}
                      class="px-3 py-1 rounded border border-cl-lime/40 text-cl-lime text-sm font-bold hover:bg-cl-lime/10 transition-colors"
                    >
                      {l.division}
                    </a>
                  ),
                )}
              </div>
            )}
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start w-full">
        <DomesticLeagueTable league={league} theme="fcl" showSeeLeague={false} />

        <section class="w-full">
          <h2 class="text-xl font-bold text-cl-lime uppercase mb-3">Champions History</h2>
          {rows.length > 0 ? (
            <div class="rounded-2xl border border-cl-lime/20 bg-cl-black/40 p-4 divide-y divide-cl-lime/10">
              {rows.map((r) => (
                <div key={r.season} class="flex items-center gap-3 py-2.5">
                  <span class="w-14 shrink-0 text-cl-lime font-bold tabular-nums">{r.season}</span>
                  <span class="flex-1 min-w-0 flex items-center gap-2">
                    <StarIcon class="w-4 h-4 fill-amber-400 shrink-0" />
                    <Image
                      src={getClubById(r.championId)?.logoPath ?? DefaultLeagueLogo}
                      alt={clubName(r.championId)}
                      width={24}
                      height={24}
                      loading="lazy"
                      quality={70}
                      format="webp"
                      class="w-6 h-6 object-contain shrink-0 rounded-sm"
                    />
                    <span class="font-semibold text-white truncate">{clubName(r.championId)}</span>
                    <span class="text-xs text-text-muted shrink-0">({r.ordinal})</span>
                  </span>
                  <span class="flex-1 min-w-0 flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-slate-300 shrink-0" />
                    <Image
                      src={getClubById(r.runnerUpId)?.logoPath ?? DefaultLeagueLogo}
                      alt={clubName(r.runnerUpId)}
                      width={24}
                      height={24}
                      loading="lazy"
                      quality={70}
                      format="webp"
                      class="w-6 h-6 object-contain shrink-0 rounded-sm"
                    />
                    <span class="text-white/80 truncate">{clubName(r.runnerUpId)}</span>
                  </span>
                  <span class="flex-1 min-w-0 flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-amber-700 shrink-0" />
                    <Image
                      src={getClubById(r.thirdId)?.logoPath ?? DefaultLeagueLogo}
                      alt={clubName(r.thirdId)}
                      width={24}
                      height={24}
                      loading="lazy"
                      quality={70}
                      format="webp"
                      class="w-6 h-6 object-contain shrink-0 rounded-sm"
                    />
                    <span class="text-white/80 truncate">{clubName(r.thirdId)}</span>
                  </span>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-text-muted italic text-sm py-4">No champions history loaded yet.</p>
          )}
        </section>
      </div>
    </div>
  </main>
</FCLayout>
