---
// Plantel compacto derivado de players.json: ordenado por posición, con dorsal,
// badge de posición (color por rol), badge de OVR (color por valor) y estrellitas.
// Sin XI/titulares. Poderío del equipo en el header.
// Tabla de 2 columnas: jugador | club (selección) / nacionalidad (club).
import { Image } from 'astro:assets';
import type { Player } from '@data/players/index';
import { loadCurrentSquad, loadCurrentSquadByTeamId } from '@data/players';
import {
  computePlayerRating,
  computeTeamRating,
  ovrRatingColor,
  ratingToStars,
  teamRatingToStars,
} from '@config/rating';
import { positionToRole, ROLE_ORDER, ROLE_STYLE, type Role } from '@config/positions';
import { getClubByCode, getClubById } from '@data/clubs';
import { getMemberById } from 'src/utils/memberUtils';
import StarsDisplay from '@components/ui/StarsDisplay.astro';

interface Props {
  teamId?: number; // id global del equipo (fuente de verdad)
  teamCode: string; // código del equipo (fallback + buscar entrada dorsal)
  teamName?: string;
  coach?: string | null;
  formation?: string | null;
  teamType?: 'national' | 'club'; // define la 2da columna (club vs nacionalidad)
}

const {
  teamId,
  teamCode,
  teamName,
  coach = null,
  formation = null,
  teamType = 'national',
} = Astro.props;

const squad: Player[] =
  teamId !== undefined && teamId !== null
    ? loadCurrentSquadByTeamId(teamId)
    : loadCurrentSquad(teamCode);

interface SquadRow {
  player: Player;
  number: number | null;
  role: Role;
  position: string;
  rating: number;
  stars: number;
  clubName: string | null; // selección: club activo del jugador
  nationality: { name: string; flag: ImageMetadata | null } | null; // club: nacionalidad
}

const rows: SquadRow[] = squad.map((player) => {
  const entry = player.teams.find(
    (t) =>
      t.status === 'active' &&
      (teamId !== undefined && teamId !== null
        ? t.teamId === teamId
        : t.teamCode.trim().toLowerCase() === teamCode.trim().toLowerCase()),
  );
  const rating = computePlayerRating(player.skills, player.position);
  const position = player.position || 'CF';

  let clubName: string | null = null;
  if (teamType === 'national') {
    const clubEntry = player.teams.find(
      (t) => t.teamType === 'club' && t.status === 'active',
    );
    if (clubEntry) {
      const club =
        clubEntry.teamId !== undefined && clubEntry.teamId !== null
          ? getClubById(clubEntry.teamId)
          : getClubByCode(clubEntry.teamCode);
      clubName = club?.name ?? clubEntry.teamCode;
    }
  }

  let nationality: { name: string; flag: ImageMetadata | null } | null = null;
  if (teamType === 'club') {
    const member = getMemberById(player.nationalityId);
    nationality = member
      ? { name: member.data.name, flag: member.data.flagPath }
      : null;
  }

  return {
    player,
    number: entry?.number ?? null,
    role: positionToRole(position),
    position,
    rating,
    stars: ratingToStars(rating),
    clubName,
    nationality,
  };
});

rows.sort(
  (a, b) =>
    ROLE_ORDER[a.role] - ROLE_ORDER[b.role] ||
    a.position.localeCompare(b.position) ||
    a.player.name.localeCompare(b.player.name),
);

const teamRating = computeTeamRating(squad);
const teamStars = teamRatingToStars(teamRating);
---

{
  rows.length > 0 ? (
    <div class="bg-surface/80 shadow-lg rounded-lg p-6 mb-8">
      <div class="flex items-baseline justify-between gap-4 flex-wrap mb-4 border-b pb-2 border-primary">
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="text-2xl font-semibold text-white">Squad</h2>
          {teamName && <span class="text-sm text-text-muted">{teamName}</span>}
          {coach && <span class="text-sm text-text-muted">Coach: {coach}</span>}
          {formation && (
            <span class="text-sm text-text-muted">Formation: {formation}</span>
          )}
        </div>
        <div class="flex items-center gap-2">
          <span class="text-sm text-text-muted">Power:</span>
          <StarsDisplay value={teamStars} size="w-4 h-4" />
          <span class="text-sm font-semibold text-primary-muted">
            {teamRating || '-'}
          </span>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm table-auto border-collapse">
          <thead class="bg-primary-deep text-white">
            <tr>
              <th scope="col" class="px-3 py-2 rounded-tl-lg text-left" title="Player">Player</th>
              <th scope="col" class="px-3 py-2 rounded-tr-lg text-right">
                {teamType === 'national' ? 'Club' : 'Nationality'}
              </th>
            </tr>
          </thead>
          <tbody>
            {rows.map(({ player, number, position, role, rating, stars, clubName, nationality }) => {
              const ovrColor = ovrRatingColor(rating);
              return (
                <tr class="border-b border-primary-dark hover:bg-surface-raised/20">
                  <td class="px-3 py-2">
                    <div class="flex items-center gap-2">
                      <span class="w-6 shrink-0 text-center font-semibold text-primary-muted">
                        {number ?? ''}
                      </span>
                      <span
                        class={`inline-flex items-center rounded px-1.5 py-0.5 text-xs font-bold ${ROLE_STYLE[role]}`}
                        title={position}
                      >
                        {position}
                      </span>
                      <span class="font-medium text-white">{player.name}</span>
                      {rating > 0 && (
                        <span
                          class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-bold"
                          style={{ backgroundColor: ovrColor.bg, color: ovrColor.text }}
                          title={`OVR ${rating}`}
                        >
                          {rating}
                        </span>
                      )}
                      <StarsDisplay value={stars} size="w-3 h-3" />
                    </div>
                  </td>
                  <td class="px-3 py-2 text-right">
                    {teamType === 'national' ? (
                      clubName ? (
                        <span class="text-text-muted">{clubName}</span>
                      ) : (
                        <span class="text-text-muted/50">—</span>
                      )
                    ) : nationality ? (
                      <div class="flex items-center justify-end gap-2">
                        {nationality.flag && (
                          <Image
                            src={nationality.flag}
                            alt={nationality.name}
                            class="w-6 h-4 object-cover rounded"
                            height={24}
                            width={36}
                            loading="lazy"
                            quality={10}
                            format="webp"
                          />
                        )}
                        <span class="text-text-muted">{nationality.name}</span>
                      </div>
                    ) : (
                      <span class="text-text-muted/50">—</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  ) : null
}