---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import StarsDisplay from '@components/ui/StarsDisplay.astro';
import { ROUTES } from '@config/routes';

import DefaultLogo from '@images/members/default_logo.png';

const { name, code, slug, index = 0, stars = 0 } = Astro.props;
let { flagPath, logoPath } = Astro.props;

const logoClass = logoPath 
  ? "max-h-32 w-auto max-w-32"
  : "max-h-32 w-auto max-w-32 opacity-5";

if (!logoPath) logoPath = DefaultLogo;
if (!flagPath) flagPath = DefaultLogo;

const loading = index < 24 ? "eager" : "lazy";
---
<a href={ROUTES.members.detail(slug)} class="flex flex-col p-4 border gap-4 ring-0 hover:ring-2 hover:ring-primary-light transition-all duration-300 border-primary-deep items-center rounded-4xl">
  <div class="flex h-full items-center">
    {logoPath && <Image src={logoPath} class={logoClass} alt={name} 
      width={220} quality={60} format='webp' loading={loading}/>} 
  </div>
  <div class="w-full flex gap-2 items-center justify-center"> 
    {flagPath && <Image src={flagPath} width={60} quality={60} format='webp'
    class="h-6 w-10 rounded-xl object-cover ring-1 ring-primary-dark" alt={name} loading={loading}/>}
    <p class="text-sm my-2">{code}</p>
  </div>
  {stars > 0 && (
    <div class="flex items-center justify-center">
      <StarsDisplay value={stars} size="w-3 h-3" />
    </div>
  )}
</a>
