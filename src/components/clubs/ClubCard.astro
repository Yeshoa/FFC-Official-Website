---
// ClubCard: tarjeta de la galería /clubs (estilo member card, estética CL).
// Logo grande sin recuadro (fallback clubs/default.png), bandera + code de la federación,
// nombre del club y estrellas del equipo.
import { Image } from 'astro:assets';
import type { Club } from '@data/clubs';
import type { Member } from '@ty/collections';
import { ROUTES } from '@config/routes';
import { resolveImage } from '@utils/imageAssets';
import DefaultClubLogo from '@images/clubs/default.png';
import StarsDisplay from '@components/ui/StarsDisplay.astro';

interface Props {
  club: Club;
  federation: Member | null;
  rating: number;
  stars: number;
}

const { club, federation, rating, stars } = Astro.props;
const logo = resolveImage(club.logoPath);
const logoClass = logo
  ? "max-h-32 w-auto max-w-32"
  : "max-h-32 w-auto max-w-32 opacity-60";
---

<a
  href={ROUTES.clubs.detail(club.slug)}
  class="flex flex-col p-4 border gap-4 ring-0 hover:ring-2 hover:ring-cl-lime transition-all duration-300 border-cl-lime/30 items-center rounded-4xl bg-cl-black/30"
>
  <div class="flex h-full items-center">
    <Image
      src={logo ?? DefaultClubLogo}
      class={logoClass}
      alt={`Logo de ${club.name}`}
      width={220}
      quality={60}
      format="webp"
      loading="lazy"
    />
  </div>
  <div class="w-full flex gap-2 items-center justify-center">
    {federation?.data.flagPath && (
      <Image
        src={federation.data.flagPath}
        width={60}
        quality={60}
        format="webp"
        class="h-6 w-10 rounded-xl object-cover ring-1 ring-cl-lime/40"
        alt={federation.data.name}
        loading="lazy"
      />
    )}
    <p class="text-sm font-bold">{federation?.data.code ?? club.federation}</p>
  </div>

  <div class="flex flex-col items-center gap-1">
    <p class="text-sm font-semibold text-center text-white">{club.name}</p>
    <StarsDisplay value={stars} size="w-3 h-3" />
  </div>
</a>
