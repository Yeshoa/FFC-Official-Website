---
// ClubCard: tarjeta de la galería /clubs. Escudo, nombre, federación, rating + estrellas.
import { Image } from 'astro:assets';
import type { Club } from '@data/clubs';
import type { Member } from '@ty/collections';
import { ROUTES } from '@config/routes';
import StarsDisplay from '@components/ui/StarsDisplay.astro';

interface Props {
  club: Club;
  federation: Member | null;
  rating: number;
  stars: number;
}

const { club, federation, rating, stars } = Astro.props;
const primary = club.colors?.primary ?? '#95ff00';
---

<a
  href={ROUTES.clubs.detail(club.code)}
  class="flex flex-col items-center gap-3 p-5 border border-primary-deep rounded-3xl hover:ring-2 hover:ring-primary-light transition-all duration-300"
>
  <div
    class="w-20 h-20 rounded-2xl border flex items-center justify-center"
    style={{ backgroundColor: `${primary}18`, borderColor: primary }}
  >
    {club.logoPath ? (
      <Image
        src={club.logoPath}
        alt={`Logo de ${club.name}`}
        width={96}
        quality={60}
        format="webp"
        loading="lazy"
        class="w-12 h-12 object-contain"
      />
    ) : (
      <span class="text-3xl font-black" style={{ color: primary }}>
        {club.shortName?.[0] ?? club.name[0]}
      </span>
    )}
  </div>

  <div class="flex flex-col items-center gap-1">
    <p class="text-sm font-semibold text-center">{club.name}</p>
    {federation && (
      <p class="text-xs text-text-muted">{federation.data.name}</p>
    )}
  </div>

  <div class="flex items-center gap-2">
    <span class="text-sm font-bold" style={{ color: primary }}>{rating}</span>
    <StarsDisplay value={stars} size="w-3 h-3" />
  </div>
</a>