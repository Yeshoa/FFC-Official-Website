---
import { Image } from 'astro:assets';
import { getRarityStyle } from '@lib/achievements/utils';
import type { Achievement } from '@lib/achievements';

interface Props {
  achievement: Achievement;
}

const { achievement } = Astro.props as Props;
const rarity = getRarityStyle(achievement.rarity, achievement.alignment);

const badgeClasses = [
  'relative group flex items-center justify-center',
  'w-11 h-11 rounded-lg',
  `border ${rarity.border}`,
  `bg-surface transition-transform duration-200 hover:scale-110`,
  'cursor-help',
].join(' ');
---

<div class={badgeClasses} title={achievement.name}>
  <Image
    class="w-7 h-7 object-contain"
    src={achievement.icon}
    alt={achievement.name}
    loading="lazy"
  />

  <!-- Tooltip -->
  <div
    class="pointer-events-none absolute bottom-full left-1/2 z-50 mb-2 w-52 -translate-x-1/2"
  >
    <div
      class="rounded-lg border border-surface-muted bg-surface-strong/95 p-2 text-center opacity-0 shadow-xl transition-opacity duration-200 group-hover:opacity-100"
    >
      <p class="text-xs font-bold text-primary">{achievement.name}</p>
      <p class="mt-1 text-[10px] leading-tight text-primary-strong">
        {achievement.description}
      </p>
    </div>
  </div>
</div>
