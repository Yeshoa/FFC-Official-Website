---
// ScorersTable: goleadores y asistidores. Soporta dos modos:
//  - Torneo (miembros de todas las selecciones): `members` completo.
//  - Equipo único (selección o club): `teamId` + `teamName` (resuelve por id global).
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getMemberByName, getTeamById, getTeamView } from 'src/utils/memberUtils';
import { getGoalPlayerName } from 'src/utils/playerUtils';
import { ROUTES } from '@config/routes';
import type { Member } from '@ty/collections';
import type { TeamView } from '@ty/matchDetail';

interface Props {
  members?: Member[];
  matches: CollectionEntry<'matches'>[];
  tournamentId?: number;
  teamId?: number;
  teamName?: string;
}

const { members = [], matches, tournamentId, teamId, teamName } = Astro.props;

const filteredMatches = tournamentId
  ? matches.filter(m => m.data.tournament_id === tournamentId)
  : matches;

type TeamRef = TeamView | string;

const goalStats = new Map<string, { player: string; team: TeamRef; goals: number; assists: number }>();
const assistStats = new Map<string, { player: string; team: TeamRef; assists: number; goals: number }>();

const singleTeam = teamName ?? (members.length === 1 ? members[0].data.name : null);

// Resuelve el display del equipo de un gol (bandera para selección, inicial para club).
async function resolveTeam(teamLabel: string): Promise<TeamRef> {
  if (teamId !== undefined && teamId !== null) {
    const ref = await getTeamById(teamId);
    return getTeamView(ref, teamLabel);
  }
  const member = await getMemberByName(teamLabel);
  if (member) {
    return {
      name: member.data.name,
      code: member.data.code,
      flag: member.data.flagPath ?? null,
      href: ROUTES.members.detail(member.id),
      type: 'national',
    };
  }
  return teamLabel;
}

for (const match of filteredMatches) {
  if (!match.data.goals) continue;

  for (const goal of match.data.goals) {
    if (singleTeam && goal.team !== singleTeam || (goal.player === undefined && goal.playerId === undefined)) continue;
    const goalKey = `${goal.playerId ?? goal.player}-${goal.team}`;

    if (!goal.ownGoal) {
      if (!goalStats.has(goalKey)) {
        goalStats.set(goalKey, {
          player: getGoalPlayerName(goal),
          team: await resolveTeam(goal.team),
          goals: 1,
          assists: 0,
        });
      } else {
        goalStats.get(goalKey)!.goals++;
      }
    }

    if (assistStats.has(goalKey)) {
      assistStats.get(goalKey)!.goals++;
    }

    if (goal.assist) {
      const assistKey = `${goal.assistId ?? goal.assist}-${goal.team}`;
      if (!assistStats.has(assistKey)) {
        assistStats.set(assistKey, {
          player: getGoalPlayerName({ ...goal, player: goal.assist, playerId: goal.assistId }),
          team: await resolveTeam(goal.team),
          assists: 1,
          goals: 0,
        });
      } else {
        assistStats.get(assistKey)!.assists++;
      }
    }
  }
}

const topScorers = Array.from(goalStats.values())
  .sort((a, b) => b.goals - a.goals || b.assists - a.assists)
  .slice(0, 10);

const topAssisters = Array.from(assistStats.values())
  .sort((a, b) => b.assists - a.assists || b.goals - a.goals)
  .slice(0, 10);
---

<section class="flex items-start flex-col sm:flex-row px-1">
{topScorers.length >= 1 && (
  <div class="overflow-x-auto w-full">
    <h2 class="text-3xl font-bold text-center py-6">Top Scorers</h2>
    <table class="min-w-full text-sm border border-primary-dark rounded-lg overflow-hidden">
      <thead>
        <tr class="bg-primary-deep text-white">
          <th class="px-4 py-2 text-left">Player</th>
          <th class="px-4 py-2 text-right">Goals</th>
        </tr>
      </thead>
      <tbody>
        {topScorers.map((entry, index) => (
          <tr class="border-b border-primary-dark hover:bg-surface-raised/30 transition duration-150" key={index}>
            <td class="px-4 py-2 font-semibold">
              <div class="flex items-center gap-2">
                {typeof entry.team !== 'string' && entry.team.flag && (
                  <Image
                    src={entry.team.flag}
                    alt={entry.team.name}
                    class="w-6 h-4 object-cover rounded shrink-0"
                    height={36}
                    loading="lazy"
                    quality={10}
                    format="webp"
                  />
                )}
                {typeof entry.team !== 'string' && !entry.team.flag && entry.team.type === 'club' && (
                  <span
                    class="w-6 h-4 rounded shrink-0 flex items-center justify-center text-[10px] font-black ring-1 ring-gray-600"
                    style={{ backgroundColor: `${entry.team.color ?? '#95ff00'}22`, color: entry.team.color ?? '#95ff00' }}
                  >
                    {entry.team.name[0]}
                  </span>
                )}
                {entry.player}
              </div>
            </td>
            <td class="px-4 py-2 text-right font-bold">{entry.goals}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

{topAssisters.length >= 1 && (
  <div class="overflow-x-auto w-full">
    <h2 class="text-3xl font-bold text-center py-6">Top Assists</h2>
    <table class="min-w-full text-sm border border-primary-dark rounded-lg overflow-hidden">
      <thead>
        <tr class="bg-primary-deep text-white">
          <th class="px-4 py-2 text-left">Player</th>
          <th class="px-4 py-2 text-right">Assists</th>
        </tr>
      </thead>
      <tbody>
        {topAssisters.map((entry, index) => (
          <tr class="border-b border-primary-dark hover:bg-surface-raised/30 transition duration-150" key={index}>
            <td class="px-4 py-2 font-semibold">
              <div class="flex items-center gap-2">
                {typeof entry.team !== 'string' && entry.team.flag && (
                  <Image
                    src={entry.team.flag}
                    alt={entry.team.name}
                    class="w-6 h-4 object-cover rounded shrink-0"
                    height={36}
                    loading="lazy"
                    quality={10}
                    format="webp"
                  />
                )}
                {typeof entry.team !== 'string' && !entry.team.flag && entry.team.type === 'club' && (
                  <span
                    class="w-6 h-4 rounded shrink-0 flex items-center justify-center text-[10px] font-black ring-1 ring-gray-600"
                    style={{ backgroundColor: `${entry.team.color ?? '#95ff00'}22`, color: entry.team.color ?? '#95ff00' }}
                  >
                    {entry.team.name[0]}
                  </span>
                )}
                {entry.player}
              </div>
            </td>
            <td class="px-4 py-2 text-right font-bold">{entry.assists}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
</section>
