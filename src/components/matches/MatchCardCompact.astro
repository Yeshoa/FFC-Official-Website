---
import  { type CollectionEntry } from 'astro:content';
import { getTournaments } from '@lib/collections';
import { LOCALE } from '@config/constants';
import { getMatchResult, getPenaltiesResult } from 'src/utils/matchUtils';
import { getTeamById, getTeamView } from 'src/utils/memberUtils';
import { Image } from 'astro:assets';

interface Props {
  match: CollectionEntry<'matches'>['data'];
}

const tournaments = await getTournaments();
const { match } = Astro.props;
const tournament = tournaments.find(t => t.data.id === match.tournament_id);
const date = new Date(match.date);
const { team1, team2 } = match;
const { team1: score1, team2: score2 } = getMatchResult(match);
const penalties = getPenaltiesResult(match);

const [team1View, team2View] = await Promise.all([
  getTeamById(match.team1Id).then((ref) => getTeamView(ref, team1)),
  getTeamById(match.team2Id).then((ref) => getTeamView(ref, team2)),
]);

// Texto de penales si aplica
const penaltyText = penalties
  ? ` (${penalties.team1}–${penalties.team2} p)`
  : '';
---
<div class="bg-surface/80 rounded-md px-4 py-3 w-full gap-2">
  <div class="text-xs text-gray-300 flex gap-1 justify-between px-3 pb-2">
    <div class="">
      <span class="font-semibold">{tournament?.data.type === 'forest-cup' ? 'Forest Cup' : 'Champions League'} {tournament?.data.edition}</span>
      <span>{match.group ? 'Groups' : match.fixture ? match.fixture : ''}</span>
    </div>
    <span>{date.toLocaleDateString(LOCALE, { day: 'numeric', month: 'short', year: 'numeric' })}</span>
  </div>
  <div class="w-full flex items-center justify-center gap-2 text-sm text-white">
    <!-- Team 1 -->
    <div class="flex items-center gap-2 flex-1 justify-end">
      <span class="truncate max-w-[100px] text-right" title={team1}>{team1View.name}</span>
      {team1View.flag ? (
        <Image src={team1View.flag} alt={team1View.name} class="w-5 h-4 object-cover rounded-sm" loading="lazy" format="webp"
        quality={1} />
      ) : team1View.type === 'club' ? (
        <span class="w-5 h-4 rounded-sm flex items-center justify-center text-[9px] font-black ring-1 ring-gray-600"
          style={{ backgroundColor: `${team1View.color ?? '#95ff00'}22`, color: team1View.color ?? '#95ff00' }}>
          {team1View.name[0]}
        </span>
      ) : (
        <div class="w-5 h-4 bg-gray-600 rounded-sm" />
      )}
    </div>
  
    <!-- Score -->
    <div class="flex items-center gap-1 text-lg font-semibold text-white mx-4">
      <span>{score1}</span>
      <span class="text-text-muted">–</span>
      <span>{score2}</span>
      {penaltyText && (
        <span class="text-xs text-yellow-400 font-normal ml-1">{penaltyText}</span>
      )}
    </div>
  
    <!-- Team 2 -->
    <div class="flex items-center gap-2 flex-1">
      {team2View.flag ? (
        <Image src={team2View.flag} alt={team2View.name} class="w-5 h-4 object-cover rounded-sm" loading="lazy" 
        format="webp" quality={1} />
      ) : team2View.type === 'club' ? (
        <span class="w-5 h-4 rounded-sm flex items-center justify-center text-[9px] font-black ring-1 ring-gray-600"
          style={{ backgroundColor: `${team2View.color ?? '#95ff00'}22`, color: team2View.color ?? '#95ff00' }}>
          {team2View.name[0]}
        </span>
      ) : (
        <div class="w-5 h-4 bg-gray-600 rounded-sm" />
      )}
      <span class="truncate max-w-[100px]" title={team2}>{team2View.name}</span>
    </div>
  </div>
</div>

